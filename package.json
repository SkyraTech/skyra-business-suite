{
  "name": "skyra-business-suite",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.15.0 <25.0.0",
    "pnpm": ">=12.3.4"
  },
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:web": "pnpm --filter @skyra-business-suite/web run dev",
    "dev:api": "pnpm --filter @skyra-business-suite/api run dev",
    "build": "pnpm --filter @skyra-business-suite/web run build && pnpm --filter @skyra-business-suite/api run build",
    "build:web": "pnpm --filter @skyra-business-suite/web run build",
    "build:api": "pnpm --filter @skyra-business-suite/api run build",
    "lint": "pnpm --recursive run lint",
    "lint:web": "pnpm --filter @skyra-business-suite/web run lint",
    "lint:api": "pnpm --filter @skyra-business-suite/api run lint",
    "test": "pnpm --recursive run test",
    "test:web": "pnpm --filter @skyra-business-suite/web run test",
    "test:api": "pnpm --filter @skyra-business-suite/api run test",
    "typecheck": "pnpm --recursive run typecheck",
    "typecheck:web": "pnpm --filter @skyra-business-suite/web run typecheck",
    "typecheck:api": "pnpm --filter @skyra-business-suite/api run typecheck",
    "format": "prettier --write \"**/*.{ts,mts,js,mjs,html,json,yaml,yml,css,scss}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,mts,js,mjs,html,json,yaml,yml,css,scss}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "3.8.1",
    "typescript": "~6.0.2"
  }
}
