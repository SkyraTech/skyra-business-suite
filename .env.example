# ============================================================
# Application Environment & Ports
# ============================================================
NODE_ENV=development
PORT=3000
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ============================================================
# Database (PostgreSQL)
# ============================================================
# Connection pooling URL for NestJS backend
DATABASE_URL="postgresql://user:password@localhost:5432/skyra_business_suite?schema=public&sslmode=prefer"
# Direct URL for Prisma migrations
DIRECT_URL="postgresql://user:password@localhost:5432/skyra_business_suite?schema=public&sslmode=prefer"

# ============================================================
# Authentication & Security
# ============================================================
# Random 32+ byte string generated via openssl rand -base64 32
JWT_SECRET="replace-with-secure-random-jwt-secret"
JWT_EXPIRES_IN="1h"
SESSION_COOKIE_SECRET="replace-with-secure-random-cookie-secret"

# ============================================================
# Social OAuth Providers (Optional / Configurable)
# ============================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ============================================================
# Redis (BullMQ Background Jobs & Caching)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# ============================================================
# Storage (S3 / Supabase / Cloud Storage)
# ============================================================
STORAGE_BUCKET_NAME=tenant-assets
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
